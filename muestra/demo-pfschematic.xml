<?xml version="1.0" encoding="UTF-8"?>
<pfsense>
  <interfaces>
    <wan>
      <if>vtnet0</if>
      <descr>WAN</descr>
      <ipaddr>203.0.113.10</ipaddr>
      <subnet>24</subnet>
    </wan>
    <lan>
      <if>vtnet1</if>
      <descr>LAN</descr>
      <ipaddr>10.10.10.1</ipaddr>
      <subnet>24</subnet>
    </lan>
    <opt1>
      <if>vtnet2</if>
      <descr>DMZ</descr>
      <ipaddr>10.10.20.1</ipaddr>
      <subnet>24</subnet>
    </opt1>
  </interfaces>
  <filter>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>tcp</protocol>
      <source>
        <network>lan</network>
      </source>
      <destination>
        <address>SERVIDORES_WEB</address>
        <port>PUERTOS_WEB</port>
      </destination>
      <descr>Permitir LAN hacia servidores web internos</descr>
      <tracker>1001</tracker>
    </rule>
    <rule>
      <type>block</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>any</protocol>
      <source>
        <any/>
      </source>
      <destination>
        <network>lan</network>
      </destination>
      <descr>Bloquear entrada directa desde Internet hacia LAN</descr>
      <tracker>1002</tracker>
      <log/>
    </rule>
    <rule>
      <type>reject</type>
      <interface>opt1</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>tcp</protocol>
      <source>
        <address>REDES_REMOTAS</address>
      </source>
      <destination>
        <any/>
        <port>22</port>
      </destination>
      <descr>Rechazar SSH desde redes remotas de prueba</descr>
      <tracker>1003</tracker>
    </rule>
    <rule>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>udp</protocol>
      <source>
        <network>lan</network>
      </source>
      <destination>
        <address>DNS_PUBLICO</address>
        <port>53</port>
      </destination>
      <descr>Regla sin tipo explicito para validar clasificacion unknown</descr>
      <tracker>1004</tracker>
    </rule>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>icmp</protocol>
      <source>
        <address>SERVIDORES_WEB</address>
      </source>
      <destination>
        <any/>
      </destination>
      <descr>Permitir ICMP desde servidores web internos</descr>
      <tracker>1005</tracker>
      <disabled/>
    </rule>
  </filter>
  <aliases>
    <alias>
      <name>SERVIDORES_WEB</name>
      <type>host</type>
      <address>10.10.20.10 10.10.20.11</address>
      <descr>Servidores web internos de demostracion</descr>
      <detail>Aplicacion||Balanceador</detail>
    </alias>
    <alias>
      <name>PUERTOS_WEB</name>
      <type>port</type>
      <address>80 443</address>
      <descr>Puertos HTTP y HTTPS</descr>
      <detail>HTTP||HTTPS</detail>
    </alias>
    <alias>
      <name>REDES_REMOTAS</name>
      <type>network</type>
      <address>172.16.0.0/16 192.0.2.0/24</address>
      <descr>Redes remotas de laboratorio</descr>
      <detail>VPN laboratorio||Red documental</detail>
    </alias>
    <alias>
      <name>DNS_PUBLICO</name>
      <type>host</type>
      <address>resolver.example.test</address>
      <descr>Dominio de ejemplo para DNS</descr>
      <detail>Resolver controlado de documentacion</detail>
    </alias>
  </aliases>
</pfsense>
